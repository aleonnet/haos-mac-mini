# Segredos e dados da instância — nunca versionar
.ha_token
*.token
secrets.yaml
# dump da instância pessoal (states, config_entries) — comentário em linha PRÓPRIA:
# no .gitignore o "#" só inicia comentário no início da linha; no meio é literal,
# e o padrão inteiro deixa de casar.
inventario/

# Artefatos grandes
*.vdi
*.vdi.zip
*.qcow2
*.img.xz

# macOS
.DS_Store
lib/haos-splash.*
catalog/*.psv

# Python
__pycache__/
*.pyc

# Descartados em 23/08 — movidos para cá em vez de apagados
.lixo-*/

# tools/ É versionado: o ui-demo.sh mora lá de propósito, fora da biblioteca.
# A máscara ASCII de origem desconhecida continua fora:
tools/haos-mask.txt
